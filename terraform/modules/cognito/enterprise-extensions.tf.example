# Enterprise Cognito Module Extensions
# Add these resources to modules/cognito/main.tf for enterprise features

# ====================================
# SAML IDENTITY PROVIDERS
# ====================================

resource "aws_cognito_identity_provider" "saml" {
  for_each = var.enable_saml_providers ? var.saml_providers : {}

  user_pool_id  = aws_cognito_user_pool.main.id
  provider_name = each.key
  provider_type = "SAML"

  provider_details = merge({
    MetadataURL = try(each.value.metadata_url, null)
    MetadataFile = try(each.value.metadata_file, null)
  }, {
    for k, v in each.value : k => v if !contains(["metadata_url", "metadata_file", "display_name", "attribute_mapping"], k)
  })

  attribute_mapping = merge({
    email      = "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"
    given_name = "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname"
    family_name = "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname"
    username   = "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier"
  }, try(each.value.attribute_mapping, {}))

  depends_on = [aws_cognito_user_pool.main]
}

# ====================================
# OIDC IDENTITY PROVIDERS
# ====================================

resource "aws_cognito_identity_provider" "oidc" {
  for_each = var.enable_oidc_providers ? var.oidc_providers : {}

  user_pool_id  = aws_cognito_user_pool.main.id
  provider_name = each.key
  provider_type = "OIDC"

  provider_details = {
    client_id                     = local.use_secrets_manager && var.use_secrets_manager ? 
                                   lookup(local.oauth_secrets, "${each.key}_client_id", each.value.client_id) : 
                                   each.value.client_id
    client_secret                 = local.use_secrets_manager && var.use_secrets_manager ? 
                                   lookup(local.oauth_secrets, "${each.key}_client_secret", each.value.client_secret) : 
                                   each.value.client_secret
    attributes_request_method     = "GET"
    oidc_issuer                  = each.value.issuer_url
    authorize_scopes             = each.value.authorize_scopes
  }

  attribute_mapping = merge({
    email       = "email"
    given_name  = "given_name"
    family_name = "family_name"
    username    = "sub"
  }, try(each.value.attribute_mapping, {}))

  depends_on = [aws_cognito_user_pool.main]
}

# ====================================
# ENHANCED USER POOL WITH ENTERPRISE FEATURES
# ====================================

# Account Takeover Protection
resource "aws_cognito_user_pool_risk_configuration_attachment" "main" {
  count = var.enable_account_takeover_protection ? 1 : 0

  user_pool_id = aws_cognito_user_pool.main.id

  account_takeover_risk_configuration {
    notify_configuration {
      block_email {
        subject   = var.account_takeover_protection_config.notify_configuration.block_email.subject
        html_body = var.account_takeover_protection_config.notify_configuration.block_email.html_body
        text_body = var.account_takeover_protection_config.notify_configuration.block_email.html_body
      }

      dynamic "mfa_email" {
        for_each = var.account_takeover_protection_config.notify_configuration.mfa_email != null ? [1] : []
        content {
          subject   = var.account_takeover_protection_config.notify_configuration.mfa_email.subject
          html_body = var.account_takeover_protection_config.notify_configuration.mfa_email.html_body
          text_body = var.account_takeover_protection_config.notify_configuration.mfa_email.html_body
        }
      }

      from                     = "security@${var.project_name}.com"
      reply_to                 = "security@${var.project_name}.com"
      source_arn              = aws_cognito_user_pool.main.arn
    }

    actions {
      low_action {
        event_action = var.account_takeover_protection_config.actions.low_action
        notify       = var.account_takeover_protection_config.actions.low_action != "NO_ACTION"
      }

      medium_action {
        event_action = var.account_takeover_protection_config.actions.medium_action
        notify       = var.account_takeover_protection_config.actions.medium_action != "NO_ACTION"
      }

      high_action {
        event_action = var.account_takeover_protection_config.actions.high_action
        notify       = var.account_takeover_protection_config.actions.high_action != "NO_ACTION"
      }
    }
  }
}

# ====================================
# MULTI-TENANT USER GROUPS
# ====================================

resource "aws_cognito_user_group" "tenant_admin" {
  count = var.enable_multi_tenant && var.tenant_isolation_mode == "user_groups" ? 1 : 0

  name         = "tenant-admin"
  user_pool_id = aws_cognito_user_pool.main.id
  description  = "Tenant administrators with elevated permissions"
  precedence   = 10
}

resource "aws_cognito_user_group" "tenant_user" {
  count = var.enable_multi_tenant && var.tenant_isolation_mode == "user_groups" ? 1 : 0

  name         = "tenant-user"
  user_pool_id = aws_cognito_user_pool.main.id
  description  = "Standard tenant users"
  precedence   = 20
}

# ====================================
# COMPLIANCE LOGGING
# ====================================

resource "aws_cloudwatch_log_group" "cognito_audit" {
  count = var.enable_detailed_audit_logging ? 1 : 0

  name              = "/aws/cognito/${var.project_name}-${var.environment}/audit"
  retention_in_days = var.compliance_mode == "fedramp" ? 2555 : 90  # 7 years for FedRAMP
  kms_key_id       = var.kms_key_id

  tags = merge(var.tags, {
    Name    = "${var.project_name}-cognito-audit-${var.environment}"
    Type    = "AuditLog"
    Purpose = "Compliance"
  })
}

# CloudWatch Log Stream for user authentication events
resource "aws_cloudwatch_log_stream" "auth_events" {
  count          = var.enable_detailed_audit_logging ? 1 : 0
  name           = "authentication-events"
  log_group_name = aws_cloudwatch_log_group.cognito_audit[0].name
}
