# Enable Google Provider for Cognito
# terraform/google-provider.tfvars

# Enable Google as an identity provider
cognito_enable_google_provider = true

# Google OAuth credentials (you'll need to set these after creating Google OAuth app)
# cognito_google_client_id = "your-google-client-id.apps.googleusercontent.com" 
# cognito_google_client_secret = "your-google-client-secret"

# Note: Uncomment and set the actual values after creating Google OAuth app
