# Enterprise Cognito Configuration Variables
# For B2B and large-scale production deployments

# Multi-Tenant Configuration
variable "enable_multi_tenant" {
  description = "Enable multi-tenant architecture"
  type        = bool
  default     = false
}

variable "tenant_isolation_mode" {
  description = "Method for tenant isolation: user_pool_per_tenant or user_groups"
  type        = string
  default     = "user_groups"
  validation {
    condition     = contains(["user_pool_per_tenant", "user_groups"], var.tenant_isolation_mode)
    error_message = "Tenant isolation mode must be user_pool_per_tenant or user_groups."
  }
}

# Enterprise Identity Providers
variable "enable_saml_providers" {
  description = "Enable SAML identity providers for enterprise SSO"
  type        = bool
  default     = false
}

variable "saml_providers" {
  description = "SAML identity providers configuration"
  type = map(object({
    metadata_url  = optional(string)
    metadata_file = optional(string)
    display_name  = string
  }))
  default = {}
}

variable "enable_oidc_providers" {
  description = "Enable OIDC identity providers"
  type        = bool
  default     = false
}

variable "oidc_providers" {
  description = "OIDC identity providers configuration"
  type = map(object({
    issuer_url    = string
    client_id     = string
    client_secret = string
    display_name  = string
  }))
  default = {}
  sensitive = true
}

# Advanced Security
variable "account_takeover_protection" {
  description = "Account takeover protection configuration"
  type = object({
    notify_configuration = object({
      block_email = object({
        subject   = string
        html_body = string
      })
      mfa_email = optional(object({
        subject   = string
        html_body = string
      }))
    })
    actions = object({
      low_action    = string
      medium_action = string
      high_action   = string
    })
  })
  default = {
    notify_configuration = {
      block_email = {
        subject   = "Account Security Alert"
        html_body = "We detected and blocked a suspicious sign-in attempt to your account."
      }
    }
    actions = {
      low_action    = "NO_ACTION"
      medium_action = "MFA_IF_CONFIGURED"
      high_action   = "BLOCK"
    }
  }
}

variable "password_policy_enterprise" {
  description = "Enhanced password policy for enterprise use"
  type = object({
    minimum_length                   = number
    require_lowercase                = bool
    require_numbers                  = bool
    require_symbols                  = bool
    require_uppercase                = bool
    temporary_password_validity_days = number
    password_history_size           = number
  })
  default = {
    minimum_length                   = 12
    require_lowercase                = true
    require_numbers                  = true
    require_symbols                  = true
    require_uppercase                = true
    temporary_password_validity_days = 1
    password_history_size           = 24
  }
}

# Compliance Settings
variable "compliance_mode" {
  description = "Compliance mode for regulatory requirements"
  type        = string
  default     = "standard"
  validation {
    condition     = contains(["standard", "sox", "pci", "hipaa", "fedramp"], var.compliance_mode)
    error_message = "Compliance mode must be one of: standard, sox, pci, hipaa, fedramp."
  }
}

variable "data_residency_region" {
  description = "Required data residency region for compliance"
  type        = string
  default     = ""
}

variable "audit_logging_enabled" {
  description = "Enable detailed audit logging for compliance"
  type        = bool
  default     = true
}

# Performance and Scaling
variable "expected_monthly_active_users" {
  description = "Expected monthly active users for capacity planning"
  type        = number
  default     = 10000
}

variable "peak_requests_per_second" {
  description = "Expected peak authentication requests per second"
  type        = number
  default     = 100
}

# Backup and Recovery
variable "backup_retention_days" {
  description = "Backup retention period in days"
  type        = number
  default     = 35
}

variable "cross_region_backup_enabled" {
  description = "Enable cross-region backup for disaster recovery"
  type        = bool
  default     = false
}

variable "backup_regions" {
  description = "List of regions for cross-region backup"
  type        = list(string)
  default     = []
}
