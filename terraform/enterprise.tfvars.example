# Enterprise Production Configuration
# Copy this file to enterprise.tfvars and customize for your enterprise needs

# ================================
# MULTI-TENANT CONFIGURATION
# ================================
enable_multi_tenant = true
tenant_isolation_mode = "user_groups"  # or "user_pool_per_tenant" for stricter isolation

# ================================
# ENTERPRISE IDENTITY PROVIDERS
# ================================
enable_saml_providers = true
saml_providers = {
  "customer-corp" = {
    metadata_url = "https://customer-corp.okta.com/app/app_id/sso/saml/metadata"
    display_name = "Customer Corp SSO"
  }
  "enterprise-client" = {
    metadata_file = "path/to/enterprise-metadata.xml"
    display_name = "Enterprise Client SAML"
  }
}

enable_oidc_providers = true
oidc_providers = {
  "okta" = {
    issuer_url    = "https://dev-12345.okta.com"
    client_id     = "your-okta-client-id"
    client_secret = "your-okta-client-secret"
    display_name  = "Okta SSO"
  }
  "auth0" = {
    issuer_url    = "https://your-tenant.auth0.com/"
    client_id     = "your-auth0-client-id"
    client_secret = "your-auth0-client-secret"
    display_name  = "Auth0 Enterprise"
  }
}

# ================================
# SECURITY & COMPLIANCE
# ================================
compliance_mode = "sox"  # Options: standard, sox, pci, hipaa, fedramp
data_residency_region = "us-east-1"
audit_logging_enabled = true

# Enhanced password policy for enterprise
password_policy_enterprise = {
  minimum_length                   = 14
  require_lowercase                = true
  require_numbers                  = true
  require_symbols                  = true
  require_uppercase                = true
  temporary_password_validity_days = 1
  password_history_size           = 24
}

# Account takeover protection
account_takeover_protection = {
  notify_configuration = {
    block_email = {
      subject   = "[SECURITY ALERT] Suspicious Activity Detected"
      html_body = "We detected and blocked a suspicious sign-in attempt to your account from an unrecognized location. If this wasn't you, please contact support immediately."
    }
    mfa_email = {
      subject   = "[SECURITY] Additional Verification Required"
      html_body = "For your security, we require additional verification for this sign-in attempt."
    }
  }
  actions = {
    low_action    = "NO_ACTION"
    medium_action = "MFA_REQUIRED"
    high_action   = "BLOCK"
  }
}

# ================================
# PERFORMANCE & SCALING
# ================================
expected_monthly_active_users = 100000
peak_requests_per_second = 1000

# ================================
# BACKUP & DISASTER RECOVERY
# ================================
backup_retention_days = 90  # Extended for compliance
cross_region_backup_enabled = true
backup_regions = ["us-west-2", "eu-west-1"]

# ================================
# ENHANCED COGNITO SETTINGS
# ================================
cognito_advanced_security_mode = "ENFORCED"
cognito_mfa_configuration = "ON"  # Required for enterprise

# Enhanced token validity for security
cognito_access_token_validity = 30   # 30 minutes
cognito_id_token_validity = 30       # 30 minutes
cognito_refresh_token_validity = 1   # 1 day (shorter for security)

# Enterprise domain configuration
cognito_domain_name = "auth-enterprise"  # Will create auth-enterprise.auth.region.amazoncognito.com

# Production callback URLs
cognito_callback_urls = [
  "https://app.yourcompany.com/auth/callback",
  "https://admin.yourcompany.com/auth/callback",
  "https://api.yourcompany.com/auth/callback"
]

cognito_logout_urls = [
  "https://app.yourcompany.com/",
  "https://admin.yourcompany.com/",
  "https://yourcompany.com/"
]

# ================================
# SECRETS MANAGER (PRODUCTION)
# ================================
oauth_secrets_enabled = true
secrets_recovery_window_days = 30  # Extended for production

# ================================
# MONITORING & ALERTING
# ================================
cloudwatch_failed_login_threshold = 50      # Higher threshold for enterprise
cloudwatch_suspicious_activity_threshold = 25

# Enable comprehensive monitoring
enable_detailed_monitoring = true
enable_xray_tracing = true

# ================================
# COST OPTIMIZATION
# ================================
# Enable only needed OAuth providers to reduce costs
cognito_enable_google_provider = true
cognito_enable_apple_provider = false    # Disable if not needed
cognito_enable_microsoft_provider = true

# ================================
# COMMON TAGS FOR ENTERPRISE
# ================================
common_tags = {
  Project     = "cosine"
  Environment = "production"
  CostCenter  = "engineering"
  Owner       = "platform-team"
  Compliance  = "sox-pci"
  DataClass   = "confidential"
  Backup      = "required"
  ManagedBy   = "terraform"
  Repository  = "Cosine-Base-Infra"
}
