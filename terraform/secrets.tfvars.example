# Example secrets.tfvars file for enabling OAuth providers
# Copy this file and update with your actual OAuth credentials

# Secrets Manager Configuration
# Set to true to store OAuth credentials in AWS Secrets Manager (recommended for production)
oauth_secrets_enabled = true
secrets_recovery_window_days = 7

# Google OAuth Configuration
cognito_enable_google_provider = true
cognito_google_client_id = "your-google-client-id.apps.googleusercontent.com"
cognito_google_client_secret = "your-google-client-secret"

# Apple OAuth Configuration (optional)
cognito_enable_apple_provider = false
cognito_apple_client_id = "com.yourdomain.cosine.web"
cognito_apple_team_id = "YOUR_TEAM_ID"
cognito_apple_key_id = "YOUR_KEY_ID"
cognito_apple_private_key = ""

# Microsoft OAuth Configuration (optional)
cognito_enable_microsoft_provider = false
cognito_microsoft_client_id = "your-microsoft-app-id"
cognito_microsoft_client_secret = "your-microsoft-client-secret"

# Domain configuration (optional - will create hosted UI domain)
cognito_domain_name = "cosine-staging"

# Callback URLs for OAuth redirects
cognito_callback_urls = [
  "http://localhost:3000/auth/callback",
  "https://yourdomain.com/auth/callback"
]

cognito_logout_urls = [
  "http://localhost:3000/",
  "https://yourdomain.com/"
]

# Note: When oauth_secrets_enabled = true, the OAuth credentials above will be
# automatically stored in AWS Secrets Manager with KMS encryption.
# After the first deployment, you can update the credentials directly in
# Secrets Manager through the AWS Console or CLI.
