# .gitignore for Cosine Base Infrastructure

# Terraform files
**/.terraform/*
*.tfstate
*.tfstate.*
!.terraform.lock.hcl


# Crash log files
crash.log
crash.*.log

# Include override files you do wish to add to version control
# but exclude environment-specific overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
python/

# Lambda layer build artifacts
layer/
layer.zip
dependencies/
python.zip

# AWS
.aws/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Archive files
*.zip
*.tar.gz
*.rar

# Backup files
*.backup
*.bak
